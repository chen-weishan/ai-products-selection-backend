# ===================================================================
# 複製本檔，檔名改成 .env，把 SSDS_DB_PASSWORD 換成真正的密碼即可啟動。
# .env 已被 .gitignore 排除，密碼不會進版控。
# 密碼請向專案負責人索取（不要在 GitHub、公開頻道傳）。
# ===================================================================
#
# 【2026-08-21 變更：連線角色由 postgres 改為 ssds_app】
# 起因是共用資料庫事故：組員以 postgres（public 全表的 owner）連線，
# 手動 DROP 約束並刪掉 flyway_schema_history 的一列，導致全組啟動失敗。
# 現在日常連線一律用 V16 建立的受限角色 ssds_app —— 讀寫照常，
# 但不能 DDL、不能 TRUNCATE、改不了 Flyway 帳本。
#
# 變數名稱同時由 SUPABASE_* 全面改為 SSDS_*。這是刻意的：
# 舊的 .env 若還留著 SUPABASE_DB_PASSWORD（已失效的 postgres 密碼），
# 改名後它不會被讀到，也就不會出現「看起來有設定卻連不上」的假象。
# 請直接用本檔覆蓋你的 .env，不要在舊檔上東改一行西改一行。
#
# 注意：這裡的密碼「不需要」做 percent-encoding。
# 官網那串 postgresql://user:password@host/db 連線字串才需要，
# 因為密碼寫在 URL 裡；我們是用 spring.datasource.password 單獨傳給 driver。

SSDS_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
SSDS_DB_PORT=6543
SSDS_DB_NAME=postgres

# 走 pooler 時帳號格式固定為 <角色名>.<project-ref>
SSDS_DB_USER=ssds_app.aozddonvsfdrtwpuxnqi
SSDS_DB_PASSWORD=請填入 ssds_app 的密碼

# Flyway 專用：session mode 連接埠。
# transaction pooler(6543) 不支援 session 層級的 advisory lock，Flyway 會卡住，
# 因此 migration 走 5432，應用程式本身仍走 6543。
SSDS_DB_SESSION_PORT=5432


# ===================================================================
# 以下只有「負責對共用資料庫套用 migration 的人」才需要填
# ===================================================================
# 其他人保持原樣（不要設定、或設成 false）。
# Flyway 預設關閉，因為 ssds_app 對 flyway_schema_history 只有 SELECT，
# 開著只會在啟動時失敗；而共用庫的 schema 本來就該由單一負責人套用。
#
# SSDS_FLYWAY_ENABLED=true
# SSDS_MIGRATION_DB_USER=postgres.aozddonvsfdrtwpuxnqi
# SSDS_MIGRATION_DB_PASSWORD=請填入 postgres 的密碼

#API_KEY
MISTRAL_API_KEY=請輸入API_KEY

# Agent 模型路由：Medium 類以 3.5 為主、Small 類維持 Small 為主。
MODEL_CLASSIFY_PRIMARY=mistral-medium-3-5
MODEL_CLASSIFY_FALLBACK=mistral-small-latest,magistral-medium-latest
MODEL_LONG_TEXT_PRIMARY=mistral-medium-3-5
MODEL_LONG_TEXT_FALLBACK=mistral-small-latest,magistral-medium-latest
# A 軌 Agent 4（RecommendationAgent）使用的 Mistral 模型別名。
MODEL_SHORT_GEN_PRIMARY=mistral-small-latest
MODEL_SHORT_GEN_FALLBACK=mistral-medium-3-5,magistral-medium-latest
# Agent 5：TrendInterpreterAgent（實際模型仍會由程式確認 reasoning=true）
MODEL_NUMERIC_PRIMARY=mistral-small-latest
MODEL_NUMERIC_FALLBACK=mistral-medium-3-5,magistral-medium-latest
AI_CACHE_DAYS_TREND=3
# 測試階段保持 false；熱度合成排程完成部署後改為 true。
AI_TREND_SCHEDULE_ENABLED=false
AI_TREND_SCHEDULE_CRON=0 10 6 * * *
# 每日熱度合成完成後，以純規則重算 B 軌 driving keyword 與時效落差。
AI_SOURCING_TIME_GAP_SCHEDULE_ENABLED=false
AI_SOURCING_TIME_GAP_SCHEDULE_CRON=0 5 6 * * *

# Agent 6：SourcingScoutAgent（程式啟動時仍會逐一確認 reasoning=true）
MODEL_REASONING_PRIMARY=mistral-medium-3-5
MODEL_REASONING_FALLBACK=mistral-small-latest,magistral-medium-latest
LLM_TIMEOUT_SCOUT_SECONDS=90
AI_CACHE_DAYS_SOURCING=3
MISTRAL_SOURCING_CONNECTORS=parallel_search,exa_search,tavily_search
MCP_ALLOWED_TOOLS=parallel_search,exa_search,tavily_search
AI_CALIBRATION_SCHEDULE_ENABLED=false
SCHEDULE_CALIBRATION=0 0 8,9 1 1,4,7,10 *

# v3.0 AI 每日請求數預算池與每週全量分析
LLM_QUOTA_DAILY=1000
LLM_QUOTA_SHARE_TRACK_A=0.7
LLM_QUOTA_SHARE_TRACK_B=0.2
LLM_QUOTA_SHARE_RETRY=0.1
LLM_BATCH_ITEM_CAP=150
AI_FULL_ANALYSIS_SCHEDULE_ENABLED=false
SCHEDULE_FULL_SCORING=0 0 7 * * MON
SCHEDULE_FULL_SCORING_RESUME=0 0 7 * * TUE-SUN

LLM_RETRY_MAX=3
LLM_TIMEOUT_SECONDS=30
AI_CACHE_DAYS=6
