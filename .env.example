# 複製這個檔案，檔名改成 .env，把 SUPABASE_DB_PASSWORD 換成真正的密碼後即可啟動。
# 改名成 .env後這個檔案由 application.properties 的 spring.config.import 自動讀取
# .env 已被 .gitignore 排除，密碼不會進版控。
# 密碼請找專案負責人索取。
#
# 注意：這裡的密碼「不需要」做 percent-encoding。
# 官網那串 postgresql://user:password@host/db 連線字串才需要，
# 因為密碼寫在 URL 裡；我們是用 spring.datasource.password 單獨傳給 driver，直接貼原字串即可。

SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.aozddonvsfdrtwpuxnqi
SUPABASE_DB_PASSWORD=請填入資料庫密碼

# Flyway 專用：session mode 連接埠。
# transaction pooler(6543) 不支援 session 層級的 advisory lock，Flyway 會卡住，
# 因此 migration 走 5432，應用程式本身仍走 6543。
SUPABASE_DB_SESSION_PORT=5432

# A 軌 SceneClassifierAgent：由 Spring Boot 直連 Mistral Conversations API。
MISTRAL_API_KEY=請填入Mistral金鑰
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MODEL_CLASSIFY_PRIMARY=mistral-medium-latest
MODEL_CLASSIFY_FALLBACK=mistral-small-latest,magistral-medium-latest,magistral-small-latest
MODEL_LONG_TEXT_PRIMARY=mistral-medium-latest
MODEL_LONG_TEXT_FALLBACK=mistral-small-latest,magistral-medium-latest,magistral-small-latest
LLM_RETRY_MAX=3
LLM_TIMEOUT_SECONDS=30
AI_CACHE_DAYS=6

# dev profile 的 Postman Basic Auth。請自行設定，不要提交真正密碼。
DEV_BASIC_AUTH_USERNAME=ssds-dev
DEV_BASIC_AUTH_PASSWORD=請設定一組本機開發密碼
