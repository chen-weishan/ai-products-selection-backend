# ===================================================================
# 複製本檔，檔名改成 .env，把 SSDS_DB_PASSWORD 換成真正的密碼即可啟動。
# .env 已被 .gitignore 排除，密碼不會進版控。
# 密碼請向專案負責人索取（不要在 GitHub、公開頻道傳）。
# ===================================================================
#
# 【2026-08-21 變更：連線角色由 postgres 改為 ssds_app】
# 起因是共用資料庫事故：組員以 postgres（public 全表的 owner）連線，
# 手動 DROP 約束並刪掉 flyway_schema_history 的一列，導致全組啟動失敗。
# 現在日常連線一律用 V16 建立的受限角色 ssds_app —— 讀寫照常，
# 但不能 DDL、不能 TRUNCATE、改不了 Flyway 帳本。
#
# 變數名稱同時由 SUPABASE_* 全面改為 SSDS_*。這是刻意的：
# 舊的 .env 若還留著 SUPABASE_DB_PASSWORD（已失效的 postgres 密碼），
# 改名後它不會被讀到，也就不會出現「看起來有設定卻連不上」的假象。
# 請直接用本檔覆蓋你的 .env，不要在舊檔上東改一行西改一行。
#
# 注意：這裡的密碼「不需要」做 percent-encoding。
# 官網那串 postgresql://user:password@host/db 連線字串才需要，
# 因為密碼寫在 URL 裡；我們是用 spring.datasource.password 單獨傳給 driver。

SSDS_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
SSDS_DB_PORT=6543
SSDS_DB_NAME=postgres

# 走 pooler 時帳號格式固定為 <角色名>.<project-ref>
SSDS_DB_USER=ssds_app.aozddonvsfdrtwpuxnqi
SSDS_DB_PASSWORD=請填入 ssds_app 的密碼

# Flyway 專用：session mode 連接埠。
# transaction pooler(6543) 不支援 session 層級的 advisory lock，Flyway 會卡住，
# 因此 migration 走 5432，應用程式本身仍走 6543。
SSDS_DB_SESSION_PORT=5432


# ===================================================================
# 以下只有「負責對共用資料庫套用 migration 的人」才需要填
# ===================================================================
# 其他人保持原樣（不要設定、或設成 false）。
# Flyway 預設關閉，因為 ssds_app 對 flyway_schema_history 只有 SELECT，
# 開著只會在啟動時失敗；而共用庫的 schema 本來就該由單一負責人套用。
#
# SSDS_FLYWAY_ENABLED=true
# SSDS_MIGRATION_DB_USER=postgres.aozddonvsfdrtwpuxnqi
# SSDS_MIGRATION_DB_PASSWORD=請填入 postgres 的密碼


#API_KEY
MISTRAL_API_KEY=請輸入API_KEY


# ===================================================================
# Instagram hashtag 熱度（透過 Apify 平台官方 actor，非 Meta 官方 API）
# ===================================================================
# 2026-09-01 改版：Meta 官方 Graph API 的 hashtag search 需要 App Review +
# Business Verification 才能查任意 hashtag，個人開發者、沒有正式商業實體
# 過不了審核。
# 2026-09-07 再改版：改用 Apify 平台的官方 actor
# apify/instagram-hashtag-scraper。申請流程：
#   1. 註冊 apify.com 帳號
#   2. Console → Settings → Integrations，複製 Personal API token
#   3. 貼到下面 SSDS_IG_APIFY_TOKEN
#
# 注意：這支 actor 是「實際爬貼文」計費（依 SSDS_IG_RESULTS_LIMIT 決定
# 每個 hashtag 抓幾篇），不是查一次總數就好，用量會隨 hashtag 數量與
# resultsLimit 增加，請留意 Apify 帳號的用量額度。
# 未設定時 Instagram 熱度採集排程會直接跳過（不會報錯）。
SSDS_IG_APIFY_TOKEN=你的apify token
# 每個 hashtag 抓幾篇貼文來算熱度，預設 20，可留空。
SSDS_IG_RESULTS_LIMIT=
SSDS_THREADS_APIFY_TOKEN=你的apify token
SSDS_TRENDS_APIFY_TOKEN=你的apify token


# ===================================================================
# FR-12 報表
# ===================================================================
REPORT_STORAGE_PATH=./.local/reports
REPORT_ASYNC_ROW_THRESHOLD=5000
REPORT_RETENTION_DAYS=90
REPORT_RESUME_ON_STARTUP=true
# 正式環境必填；需為可讀取的 Noto Sans TC .ttf/.otf 檔案
PDF_FONT_PATH=


# ===================================================================
# FR-15 權重校準（以下皆為預設值，不需要改就可整段留著）
# ===================================================================
# 本檔以 properties 格式載入：值不要加引號，否則引號會變成值的一部分。
#
# 季度校準排程。必須同時包含 8、9 兩個時點，勿照規格書附錄 B 的 0 0 8 1 1,4,7,10 *：
# §5.10 規定季度首日為週一時順延至 09:00，job 會跳過週一 08:00 那次；
# 若 cron 沒有 9 點，該季就不會產生報告（啟動時會記 warn）。
SCHEDULE_CALIBRATION=0 0 8,9 1 1,4,7,10 *
# 季初產生報告後是否自動建立 Agent 7 解讀任務（false 時報告照常產生）。
AI_CALIBRATION_SCHEDULE_ENABLED=true
# 校準最低樣本數（附錄 B）。低於此數 S-12／S-19 顯示不可關閉的效度警示，α 也隨之縮小。
CALIBRATION_MIN_SAMPLE=200
# 單一因子有效樣本低於此數時不調整其權重（設計決定）。
# 共用庫回填很少時建議＝現行、核准鈕停用；demo 核准流程可暫時調成 3。
CALIBRATION_MIN_FACTOR_SAMPLE=10
