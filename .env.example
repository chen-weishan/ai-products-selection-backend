# 複製這個檔案，檔名改成 .env，把 SUPABASE_DB_PASSWORD 換成真正的密碼後即可啟動。
# 改名成 .env後這個檔案由 application.properties 的 spring.config.import 自動讀取
# .env 已被 .gitignore 排除，密碼不會進版控。
# 密碼請找專案負責人索取。
#
# 注意：這裡的密碼「不需要」做 percent-encoding。
# 官網那串 postgresql://user:password@host/db 連線字串才需要，
# 因為密碼寫在 URL 裡；我們是用 spring.datasource.password 單獨傳給 driver，直接貼原字串即可。

SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.aozddonvsfdrtwpuxnqi
SUPABASE_DB_PASSWORD=請填入資料庫密碼
